# Copy this file to .env.local and fill in real values. Never commit .env.local.
# All keys are server-only (no NEXT_PUBLIC_ prefix): the browser never sees them.

# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (primary LLM) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=

# Groq (live fallback LLM) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=

# UUID of the single demo shop row (created by the seed script)
DEMO_SHOP_ID=
